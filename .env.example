# Copia este archivo como `.env` y rellena los valores con los de tu proyecto Supabase.
# https://supabase.com/dashboard/project/_/settings/api
#
# IMPORTANTE:
# - SOLO usa claves PÚBLICAS (anon / publishable) aquí. Son seguras en el navegador
#   porque la base de datos está protegida con Row Level Security (RLS).
# - La service_role / secret key NUNCA debe colocarse en el frontend.
# - No commitees el archivo .env (está excluido en .gitignore).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=